units metal
atom_style atomic
boundary p p p

read_data ordered.struct

velocity all create ?temp? ?ordered_seed?

pair_style ?pair_style?
pair_coeff * * ?potential? ?elements?

neighbor ?skin? bin
neigh_modify every 1 delay 0 check yes

thermo_style custom step pe press
thermo 1

fix 1 all box/relax iso 0.0
min_style cg
minimize ?etol? ?ftol? ?maxiter? ?maxeval?

unfix 1

reset_timestep 0

neigh_modify every 10 check yes

log ordered.log
thermo_style custom step etotal press vol enthalpy
thermo ?thermo?

fix 1 all npt temp ?temp? ?temp? ?Tdamp? iso 0.0 0.0 ?Pdamp?
run ?equil?

clear

units metal
atom_style atomic
boundary p p p

read_data random.struct

velocity all create ?temp? ?random_seed?

pair_style ?pair_style?
pair_coeff * * ?potential? ?elements?

neighbor ?skin? bin
neigh_modify every 1 delay 0 check yes

thermo_style custom step pe press
thermo 1

fix 1 all box/relax iso 0.0
min_style cg
minimize ?etol? ?ftol? ?maxiter? ?maxeval?

unfix 1

reset_timestep 0

neigh_modify every 10 check yes

log random.log
thermo_style custom step etotal press vol enthalpy
thermo ?thermo?

fix 1 all npt temp ?temp? ?temp? ?Tdamp? iso 0.0 0.0 ?Pdamp?
run ?equil?